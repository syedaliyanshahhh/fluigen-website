---
// /book: the only page with the calendar (CLAUDE.md "Booking").
//
// Layout: on a phone, one short line and then the calendar, so it is on the
// first screen; the "on the call" points follow below it. From lg up, short
// text on the left and the calendar in a glass frame on the right, both on
// the hero flow field (design/brand.md "Flow gradient", "Glass").
//
// Calendar: a plain Calendly inline iframe, built by the inline script right
// after its frame so the request starts while the page is still parsing (no
// widget.js round trip). Calendly's own URL options hide the event header
// (photo, name, title, duration) and the cookie banner, and set its colors.
// A skeleton shows at once; the calendar fades in when Calendly reports it
// has rendered (`calendly.event_type_viewed`), then the frame follows the
// real content height (`calendly.page_height`). If nothing arrives in time,
// a direct booking link replaces the skeleton.
//
// The frame stays under 650px wide: from 650px Calendly switches to a boxed
// layout with its own border and margins, which would sit inside our frame.
// Below that it fills the frame edge to edge at 602px tall, on every device.
import { site } from "../site.config";
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import FlowField from "../components/FlowField.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";

// Calendly embed options. Colors are hex without '#', from design/brand.md
// "Themes": the card surface (`null`), `core` text, and `core` as the accent
// so available days and buttons follow the brand's black / near-white
// primary instead of teal text. Calendly picks a readable text color on the
// accent itself.
const calendlyOptions = "embed_type=Inline&hide_event_type_details=1&hide_landing_page_details=1&hide_gdpr_banner=1";
const calendlyColors = {
	light: "background_color=ffffff&text_color=000000&primary_color=000000",
	dark: "background_color=121a1b&text_color=f7f7f7&primary_color=f7f7f7",
};

const onCallItems = [
	"Find where your team loses the most hours",
	"Pick the first one or two processes to automate",
	"Send a written plan and fixed price within 48 hours",
];

// Skeleton month: 2 blank cells, then 30 days.
const skeletonDays = Array.from({ length: 33 }, (_, i) => i >= 2);
---

<Layout
	title="Book your free automation audit"
	description="A free 30-minute call with Aliyan. You leave with a written plan, even if you never hire us. Pick a time that suits you."
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://calendly.com" />
		<link rel="preconnect" href="https://assets.calendly.com" />
	</Fragment>
	<Nav />
	<main id="main" data-flow-end>
		<section
			class="book-y relative lg:flex lg:min-h-[calc(100svh-var(--nav-h))] lg:items-center"
			data-flow-section="hero"
		>
			<FlowField variant="hero" />
			<Container class="w-full">
				<div
					class="rise-in grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-start lg:gap-[var(--space-head)]"
				>
					<div class="lg:max-w-[34rem]">
						<h1 class="sr-only font-display text-h1 text-core lg:not-sr-only">Book your free automation audit</h1>
						<p class="text-body text-core lg:mt-6">A free 30-minute call with Aliyan.</p>
						<div class="mt-10 hidden lg:block">
							<div class="space-y-3">
								<p class="font-mono text-label uppercase text-ink-2">On the call we will</p>
								<ul class="space-y-3">
									{
										onCallItems.map((item) => (
											<li class="flex gap-3 text-body text-core">
												<Icon name="check" class="mt-[3px] h-5 w-5 shrink-0 text-core" />
												<span>{item}</span>
											</li>
										))
									}
								</ul>
							</div>
							<p class="mt-8 text-small text-core">
								Can't find a time? Email <a
									href={`mailto:${site.email}`}
									class="link-u text-core outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-ring"
									>{site.email}</a
								>
							</p>
						</div>
					</div>

					<div class="glass w-full max-w-[40rem] rounded-panel p-2 lg:justify-self-end">
						<div
							id="cal"
							class="cal relative overflow-hidden rounded-card bg-null"
							style="height: 602px"
							aria-busy="true"
							data-base={site.bookingUrl}
							data-options={calendlyOptions}
							data-light={calendlyColors.light}
							data-dark={calendlyColors.dark}
						>
							<div class="cal-skeleton absolute inset-0 flex flex-col items-center px-4 pt-7" aria-hidden="true">
								<span class="cal-bone h-6 w-40 rounded-full"></span>
								<div class="mt-12 flex w-full max-w-[20rem] items-center justify-between px-12">
									<span class="cal-bone h-4 w-4 rounded-full"></span>
									<span class="cal-bone h-4 w-28 rounded-full"></span>
									<span class="cal-bone h-4 w-4 rounded-full"></span>
								</div>
								<div class="mt-7 grid w-full max-w-[20rem] grid-cols-7 justify-items-center gap-y-1">
									{Array.from({ length: 7 }, () => <span class="cal-bone mb-4 h-2.5 w-6 rounded-full" />)}
									{
										skeletonDays.map((day) =>
											day ? (
												<span class="cal-bone cal-bone--soft aspect-square w-[88%] max-w-11 rounded-full" />
											) : (
												<span />
											),
										)
									}
								</div>
								<div class="mt-8 w-full max-w-[20rem] space-y-3 px-1">
									<span class="cal-bone block h-3 w-20 rounded-full"></span>
									<span class="cal-bone block h-3 w-52 rounded-full"></span>
								</div>
							</div>

							<div class="cal-fallback absolute inset-0 flex-col items-start justify-center gap-6 p-8 sm:p-10">
								<p class="text-body text-ink-2">The calendar did not load. Open the booking page directly instead.</p>
								<Button href={site.bookingUrl}>Open the booking page</Button>
							</div>

							<p class="sr-only" role="status" id="cal-status">Loading the calendar</p>
							<noscript>
								<style>
									.cal-skeleton {
										display: none !important;
									}
									.cal-fallback {
										display: flex !important;
									}
								</style>
							</noscript>
						</div>
						<!-- Inline (not bundled) so the iframe request starts during parsing. -->
						<script is:inline>
							(function () {
								var cal = document.getElementById("cal");
								var status = document.getElementById("cal-status");
								if (!cal) return;
								// No calendar after this long: offer the direct link. A late calendar
								// still replaces it when it arrives.
								var FALLBACK_MS = 10000;
								// Calendly reports tiny heights (26px, 2px) while it boots; only real
								// content heights after the calendar has rendered are applied.
								var MIN_HEIGHT = 300;
								var frame, timer, ready;

								function src() {
									var dark = document.documentElement.dataset.theme === "dark";
									return (
										cal.dataset.base +
										"?embed_domain=" + encodeURIComponent(location.host) +
										"&" + cal.dataset.options +
										"&" + (dark ? cal.dataset.dark : cal.dataset.light)
									);
								}

								function load() {
									if (frame) frame.remove();
									ready = false;
									cal.classList.remove("is-ready", "is-failed");
									cal.setAttribute("aria-busy", "true");
									status.textContent = "Loading the calendar";
									frame = document.createElement("iframe");
									frame.className = "cal-frame";
									frame.title = "Booking calendar";
									frame.src = src();
									cal.appendChild(frame);
									clearTimeout(timer);
									timer = setTimeout(function () {
										if (ready) return;
										cal.classList.add("is-failed");
										cal.setAttribute("aria-busy", "false");
										status.textContent = "The calendar did not load. Use the booking page link instead.";
									}, FALLBACK_MS);
								}

								window.addEventListener("message", function (event) {
									if (event.origin !== "https://calendly.com" || !frame || event.source !== frame.contentWindow) return;
									var name = event.data && event.data.event;
									if (name === "calendly.event_type_viewed" && !ready) {
										ready = true;
										clearTimeout(timer);
										cal.classList.remove("is-failed");
										cal.classList.add("is-ready");
										cal.setAttribute("aria-busy", "false");
										status.textContent = "Calendar loaded";
									} else if (name === "calendly.page_height" && ready) {
										var height = parseFloat(event.data.payload && event.data.payload.height);
										if (height >= MIN_HEIGHT) cal.style.height = height + "px";
									}
								});

								// Calendly's colors follow the page theme: rebuild on a theme switch.
								window.addEventListener("fluigen:themechange", load);

								load();
							})();
						</script>
					</div>
				</div>
			</Container>
		</section>

		<section class="pb-[var(--space-block)] lg:hidden" data-reveal-scope>
			<Container>
				<div class="space-y-3">
					<p class="font-mono text-label uppercase text-ink-3">On the call we will</p>
					<ul class="space-y-3">
						{
							onCallItems.map((item) => (
								<li class="flex gap-3 text-body text-ink-2">
									<Icon name="check" class="mt-[3px] h-5 w-5 shrink-0 text-core" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
				</div>
				<p class="mt-8 text-small text-ink-3">
					Can't find a time? Email <a
						href={`mailto:${site.email}`}
						class="link-u text-core outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-ring"
						>{site.email}</a
					>
				</p>
			</Container>
		</section>
	</main>
	<Footer />
</Layout>


<style is:global>
	.cal-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		/* Match Calendly's own scheme. A mismatch with the page's dark
		   scheme makes the browser paint an opaque white backdrop behind
		   the iframe, which showed as a line under the calendar. */
		color-scheme: light;
		opacity: 0;
		transition: opacity 0.6s var(--ease-out);
	}
	.cal.is-ready .cal-frame {
		opacity: 1;
	}

	.cal-skeleton {
		transition:
			opacity 0.45s var(--ease-out),
			visibility 0s;
	}
	.cal.is-ready .cal-skeleton,
	.cal.is-failed .cal-skeleton {
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.45s var(--ease-out),
			visibility 0s 0.45s;
	}
	.cal-bone {
		background-color: var(--rule);
		animation: cal-pulse 1.4s var(--ease-in-out) infinite alternate;
	}
	.cal-bone--soft {
		background-color: color-mix(in oklab, var(--rule) 55%, transparent);
	}
	@keyframes cal-pulse {
		to {
			opacity: 0.45;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cal-bone {
			animation: none;
		}
	}

	.cal-fallback {
		display: none;
	}
	.cal.is-failed .cal-fallback {
		display: flex;
	}
</style>
