---
// /book — the only page with the calendar (CLAUDE.md "Booking"). Calendly
// inline embed via their official widget.js pattern, with a fallback link
// shown if the widget script fails to load or never initializes.
//
// Layout: details and calendar sit side by side from lg up, and the whole
// block is centered within the viewport height below the nav, so the
// calendar is visible without scrolling the page on laptop/desktop widths.
// Below lg there isn't room for both side by side, so it stacks and
// scrolls normally, same as every other two-column section on the site.
//
// The widget's height is NOT a guessed fixed value — Calendly posts its
// real content height via `calendly.page_height` messages (their
// documented inline-embed resize API), and the listener below applies
// that directly, so the box always hugs the actual calendar instead of
// leaving empty space around a shorter view.
import { site } from "../site.config";
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";

const CALENDLY_URL = site.bookingUrl;
// Calendly embed customization params (hex without '#') to match the brand
// as far as Calendly allows — see design/brand.md colors. One set per theme;
// the script picks the current one and reloads the calendar if the visitor
// switches theme.
const calendlyColors = {
	light: "background_color=f7f7f7&text_color=000000&primary_color=267b85",
	dark: "background_color=0a0f10&text_color=f7f7f7&primary_color=97c1c5",
};

const onCallItems = [
	"Look at where your team loses the most hours",
	"Pick the one or two processes worth automating first",
	"Send you a written plan with a fixed price within 48 hours",
];
---

<Layout
	title="Book your free automation audit"
	description="A free 30-minute call with Aliyan. You leave with a written plan, even if you never hire us. Pick a time that suits you."
>
	<Nav />
	<main id="main">
		<div class="flex flex-col justify-center py-10 lg:min-h-[calc(100svh-var(--nav-h))] lg:py-0">
			<Container>
				<div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-center lg:gap-14">
					<div class="max-w-[520px] space-y-6">
						<h1 class="font-display text-h1 text-core">Book your free automation audit</h1>
						<p class="text-body text-ink-2">
							A 30-minute call with Aliyan. Pick a time that suits you below.
						</p>
						<div class="space-y-3 pt-2">
							<p class="font-mono text-label uppercase text-ink-3">On the call we will</p>
							<ul class="space-y-3">
								{
									onCallItems.map((item) => (
										<li class="flex gap-3 text-body text-ink-2">
											<Icon name="check" class="mt-[3px] h-5 w-5 shrink-0 text-core" />
											<span>{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<p class="text-small text-ink-3 pt-2">
							Can’t find a time that works? Email <a
								href={`mailto:${site.email}`}
								class="link-u text-core outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-ring"
								>{site.email}</a
							>
						</p>
					</div>

					<div>
						<noscript>
							<style>
								#calendly-widget {
									display: none;
								}
							</style>
						</noscript>

						<div
							id="calendly-widget"
							class="calendly-inline-widget h-[660px] w-full min-w-0 lg:max-h-[calc(100svh-var(--nav-h)-3rem)]"
							data-calendly-base={CALENDLY_URL}
							data-calendly-light={calendlyColors.light}
							data-calendly-dark={calendlyColors.dark}
						>
						</div>

						<div
							id="calendly-fallback"
							class="hidden flex-col items-start gap-5 rounded-card border border-rule bg-null p-8 sm:p-10"
						>
							<p class="text-body text-ink-2">
								The calendar did not load. Open the booking page directly instead.
							</p>
							<Button href={CALENDLY_URL}>Open the booking page</Button>
						</div>

						<noscript>
							<div class="flex flex-col items-start gap-5 rounded-card border border-rule bg-null p-8 sm:p-10">
								<p class="text-body text-ink-2">Enable JavaScript to see the calendar, or book directly:</p>
								<Button href={CALENDLY_URL}>Open the booking page</Button>
							</div>
						</noscript>
					</div>
				</div>
			</Container>
		</div>
	</main>
	<Footer />

	<script>
		const CALENDLY_SCRIPT_SRC = "https://assets.calendly.com/assets/external/widget.js";
		const CALENDLY_LOAD_TIMEOUT_MS = 8000;

		const widget = document.getElementById("calendly-widget");
		const fallback = document.getElementById("calendly-fallback");

		function showFallback() {
			widget?.classList.add("hidden");
			fallback?.classList.remove("hidden");
			fallback?.classList.add("flex");
		}

		// Calendly's documented inline-embed resize API: it posts the real
		// content height any time the view changes (date picked, time slots
		// shown, confirmation form, ...), so the widget always matches its
		// actual content instead of a guessed fixed height.
		// While it is still loading, Calendly reports tiny heights (26px, then
		// 2px) before the real one. Applying those collapsed the box and made
		// the footer jump up and back down, so sizes are only applied once the
		// calendar has rendered (`calendly.event_type_viewed`); until then the
		// box keeps its reserved height.
		const MIN_CALENDAR_HEIGHT = 300;
		let calendarShown = false;
		window.addEventListener("message", (event) => {
			if (event.origin !== "https://calendly.com") return;
			if (event.data?.event === "calendly.event_type_viewed") calendarShown = true;
			if (event.data?.event !== "calendly.page_height" || !calendarShown) return;
			const height = parseFloat(event.data.payload?.height);
			if (!height || height < MIN_CALENDAR_HEIGHT || !widget) return;
			widget.style.height = `${height}px`;
		});

		// Calendly colors follow the page theme. widget.js reads data-url when
		// it loads, so set it first; on a theme switch, rebuild the calendar.
		function calendlyUrl() {
			if (!widget) return "";
			const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
			return `${widget.dataset.calendlyBase}?${widget.dataset[theme === "dark" ? "calendlyDark" : "calendlyLight"]}`;
		}
		if (widget) widget.dataset.url = calendlyUrl();

		window.addEventListener("fluigen:themechange", () => {
			if (!widget || typeof window.Calendly === "undefined") return;
			calendarShown = false;
			widget.style.height = "";
			widget.innerHTML = "";
			window.Calendly.initInlineWidget({ url: calendlyUrl(), parentElement: widget });
		});

		const script = document.createElement("script");
		script.src = CALENDLY_SCRIPT_SRC;
		script.async = true;
		script.addEventListener("error", showFallback);
		document.body.appendChild(script);

		const timeout = setTimeout(() => {
			if (typeof window.Calendly === "undefined") showFallback();
		}, CALENDLY_LOAD_TIMEOUT_MS);

		script.addEventListener("load", () => {
			clearTimeout(timeout);
			if (typeof window.Calendly === "undefined") showFallback();
		});
	</script>
</Layout>
