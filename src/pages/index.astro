---
// Homepage, sections 1-12 (docs/build-plan.md Phase 5).
import { settings, site } from "../site.config";
import { getFeaturedCaseStudies, getSolutions } from "../lib/content";
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import GradientSection from "../components/GradientSection.astro";
import Button from "../components/Button.astro";
import InlineCTA from "../components/InlineCTA.astro";
import Label from "../components/Label.astro";
import Card from "../components/Card.astro";
import StatTile from "../components/StatTile.astro";
import SolutionCard from "../components/SolutionCard.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import EmptyState from "../components/EmptyState.astro";
import FounderPhoto from "../components/FounderPhoto.astro";
import FAQItem from "../components/FAQItem.astro";
import Icon from "../components/Icon.astro";

const solutions = await getSolutions();

// The case studies marked "Featured on homepage" in content/copy/case-studies.
const caseStudies = await getFeaturedCaseStudies();

const painPoints = [
	{
		title: "Calls go to voicemail",
		description:
			"Someone rings after hours or while the team is busy. Nobody picks up, and they book with whoever answers first.",
	},
	{
		title: "Leads go cold",
		description:
			"Follow-ups slip because everyone has a full day. By the time someone replies, the lead has moved on.",
	},
	{
		title: "You chase the team for updates",
		description:
			"The same details get copied between email, spreadsheets and chat, and you spend your evenings checking what got done.",
	},
];

const proofStats = [
	{ value: "16", label: "systems managed from one client portal" },
	{ value: "24/7", label: "calls answered for a restoration company, including 2am emergencies" },
	{ value: "45 days", label: "of follow-up on every lead, with no outreach hire" },
	{ value: "2 to 3", label: "weeks from kickoff to a live system, for most builds" },
];

const steps = [
	{
		title: "Audit",
		description:
			"A 30-minute call. Within 48 hours you get a written plan with what to automate, the hours it saves, and a fixed price.",
	},
	{
		title: "Build",
		description:
			"We build one process end to end in your own accounts. You give us about two hours of your time in total.",
	},
	{
		title: "Go live",
		description:
			"We test it with real work, hand it over with written docs and a short video, and you pay the second half.",
	},
	{
		title: "Care",
		description:
			"Optional monthly plan: we watch it, fix it when your tools change, and keep improving it.",
	},
];

const guarantees = [
	{
		title: "Pay the second half when it is live",
		description: "50% to start. The rest only once the system is running in your business. Not before.",
	},
	{
		title: "You own everything",
		description:
			"Your accounts, your data, your workflows. Full handover with written documentation and a video walkthrough.",
	},
	{
		title: "30 days of free fixes",
		description: "If something needs adjusting after launch, we fix it at no cost.",
	},
];

const goodFit = [
	"Owner-led businesses with roughly 10 to 200 people",
	"The same tasks happen every day or every week",
	"You know where the hours go, but nobody has time to fix it",
	"You want it done for you, not another tool to learn",
];

const notFit = [
	"One-off experiments with no process behind them",
	"Businesses still working out how they run",
	"Anyone looking for the cheapest option or hourly billing",
];

const faqs = [
	{
		question: "Who owns what you build?",
		answer:
			"You do. We build inside your accounts wherever possible, and at handover you get every login, the workflows, written documentation and a video walkthrough.",
	},
	{
		question: "Is my data safe?",
		answer:
			"Your data stays in the tools you already use. We only ask for the access a build needs, and you can remove it the day we hand over.",
	},
	{
		question: "What if it breaks?",
		answer:
			"You get 30 days of free fixes after launch. After that, the Care Plan covers monitoring and fixes, or you can call us when you need us.",
	},
	{
		question: "How long does it take?",
		answer:
			"Most builds are live in 2 to 3 weeks. Your audit plan gives you a fixed price and a finish date before anything starts.",
	},
	{
		question: "Do I need to learn anything?",
		answer:
			"No. It runs in the background of tools your team already uses. We show your team the few things they need to know.",
	},
	{
		question: "What time zone do you work in?",
		answer: `We are based in ${site.city} and our team works remotely across time zones, so we work your business hours, whether you are in the US, UK, Europe or Australia.`,
	},
];
---

<Layout
	description="We build AI that answers your calls, follows up your leads, and runs your back office. Done for you, live in weeks."
>
	<Nav />
	<main id="main">
		<!-- 1. Hero -->
		<GradientSection variant="horizon" priority class="hero-section-y">
			<Container>
				<div class="fade-in space-y-6 sm:space-y-8">
					<h1 class="font-display text-hero-h1 text-null">
						We build AI that answers your calls, follows up your leads, and runs your back office.
					</h1>
					<p class="text-body text-null max-w-[46ch]">
						Done for you, live in weeks, and you pay the second half only once it is running.
					</p>
					<div class="flex flex-col items-start gap-4 pt-2 sm:flex-row sm:items-center sm:gap-8">
						<Button href={site.bookingPath} inverse>Book your free automation audit</Button>
						<Button href="#case-studies" variant="text" inverse>See what we have built</Button>
					</div>
					<p class="text-small text-null pt-2">
						30 minutes. You leave with a written plan, even if you never hire us.
					</p>
				</div>
			</Container>
		</GradientSection>

		<!-- 2. Proof strip -->
		<Section>
			<Container>
				<div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-12">
					{proofStats.map((stat) => <StatTile value={stat.value} label={stat.label} />)}
				</div>
			</Container>
		</Section>

		<!-- 3. The problem -->
		<Section>
			<Container>
				<h2 class="font-display text-h2 text-core max-w-[18ch]">
					What stops when one person is unavailable?
				</h2>
				<div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-3 lg:mt-16">
					{
						painPoints.map((pain, index) => (
							<div class="space-y-4">
								<Label text={String(index + 1).padStart(2, "0")} />
								<h3 class="font-display text-h3 text-core">{pain.title}</h3>
								<p class="text-body text-ink-2 max-w-[42ch]">{pain.description}</p>
							</div>
						))
					}
				</div>
				<InlineCTA class="mt-12 lg:mt-16" note="We will find the first thing worth fixing." />
			</Container>
		</Section>

		<!-- 4. What we build -->
		<Section>
			<Container>
				<div class="max-w-[640px] space-y-4">
					<h2 class="font-display text-h2 text-core">What we build</h2>
					<p class="text-body text-ink-2">
						Each of these is backed by a system we have already built and run for a real business.
					</p>
				</div>
				<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-8">
					{solutions.map((solution) => <SolutionCard solution={solution} />)}
				</div>
				{!settings.showSeeItWork && <InlineCTA class="mt-10 lg:mt-12" />}
			</Container>
		</Section>

		<!-- 5. See it work: hidden until the recording exists (settings.showSeeItWork) -->
		{
			settings.showSeeItWork && (
				<Section>
					<Container>
						<div class="max-w-[640px] space-y-4">
							<h2 class="font-display text-h2 text-core">Hear an AI receptionist take a real call</h2>
							<p class="text-body text-ink-2">
								Sixty seconds. It answers, asks the right questions, and books the appointment.
							</p>
						</div>
						<EmptyState
							label="[PLACEHOLDER: 60-second recording]"
							class="mt-10 aspect-[16/9] w-full lg:mt-12"
						>
							<span class="flex h-16 w-16 items-center justify-center rounded-full bg-null sm:h-20 sm:w-20">
								<Icon name="play" class="h-6 w-6 translate-x-[2px] text-core sm:h-7 sm:w-7" />
							</span>
						</EmptyState>
						<InlineCTA class="mt-10 lg:mt-12" />
					</Container>
				</Section>
			)
		}

		<!-- 6. Case studies -->
		<Section id="case-studies" class="scroll-mt-[var(--nav-h)]">
			<Container>
				<h2 class="font-display text-h2 text-core">Work that is already running</h2>
				<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3 lg:mt-16 lg:gap-8">
					{caseStudies.map((caseStudy) => <CaseStudyCard caseStudy={caseStudy} />)}
				</div>
				<Button href="/case-studies" variant="text" class="mt-10 inline-block lg:mt-12">
					See all case studies
				</Button>
			</Container>
		</Section>

		<!-- 7. How it works -->
		<Section>
			<Container>
				<h2 class="font-display text-h2 text-core">How it works</h2>
				<div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
					{
						steps.map((step, index) => (
							<div class="space-y-4">
								<Label text={String(index + 1).padStart(2, "0")} />
								<h3 class="font-display text-h3 text-core">{step.title}</h3>
								<p class="text-body text-ink-2">{step.description}</p>
							</div>
						))
					}
				</div>
				<InlineCTA class="mt-12 lg:mt-16" note="Step 1 is free." />
			</Container>
		</Section>

		<!-- 8. Guarantees -->
		<Section>
			<Container>
				<h2 class="font-display text-h2 text-core max-w-[16ch]">The risk sits with us</h2>
				<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3 lg:mt-16 lg:gap-8">
					{
						guarantees.map((guarantee) => (
							<Card class="space-y-4">
								<Icon name="check" class="h-6 w-6 text-core" />
								<h3 class="font-display text-h3 text-core">{guarantee.title}</h3>
								<p class="text-body text-ink-2">{guarantee.description}</p>
							</Card>
						))
					}
				</div>
			</Container>
		</Section>

		<!-- 9. Who it is for -->
		<Section>
			<Container>
				<h2 class="font-display text-h2 text-core max-w-[18ch]">Who we are a good fit for</h2>
				<div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:mt-16 lg:gap-16">
					<div class="space-y-5">
						<Label text="good fit" />
						<ul class="space-y-4">
							{
								goodFit.map((item) => (
									<li class="flex gap-3 text-body text-ink-2">
										<Icon name="check" class="mt-[3px] h-5 w-5 shrink-0 text-core" />
										<span>{item}</span>
									</li>
								))
							}
						</ul>
					</div>
					<div class="space-y-5">
						<Label text="not a fit" />
						<ul class="space-y-4">
							{
								notFit.map((item) => (
									<li class="flex gap-3 text-body text-ink-2">
										<Icon name="x" class="mt-[3px] h-5 w-5 shrink-0 text-ink-3" />
										<span>{item}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</Container>
		</Section>

		<!-- 10. Founder note -->
		<Section>
			<Container>
				<div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
					<FounderPhoto class="w-full max-w-[360px]" />
					<div class="max-w-[560px] space-y-6">
						<Label text="from the founder" />
						<blockquote class="font-display text-h3 text-core">
							"I started in performance marketing, watching good businesses lose leads to slow
							replies. Now I build the systems that stop it."
						</blockquote>
						<p class="text-body text-ink-2">
							When you book an audit, you talk to me directly, not a sales rep.
						</p>
						<p class="text-small text-ink-3">Aliyan Shah, founder of Fluigen</p>
						<InlineCTA class="pt-2" />
					</div>
				</div>
			</Container>
		</Section>

		<!-- 11. FAQ -->
		<Section>
			<Container>
				<h2 class="font-display text-h2 text-core max-w-[16ch]">Questions owners ask us</h2>
				<div class="mt-12 max-w-[760px] border-t border-rule lg:mt-16">
					{faqs.map((faq) => <FAQItem question={faq.question}>{faq.answer}</FAQItem>)}
				</div>
			</Container>
		</Section>

		<!-- 12. Final call to action (no calendar here) -->
		<GradientSection variant="mist" class="section-y">
			<Container>
				<div class="max-w-[520px] space-y-6">
					<h2 class="font-display text-h2 text-null">Find the first thing worth automating</h2>
					<p class="text-body text-null max-w-[46ch]">
						30 minutes, and you leave with a written plan, even if you never hire us.
					</p>
					<Button href={site.bookingPath} inverse>Book your free automation audit</Button>
				</div>
			</Container>
		</GradientSection>
	</main>
	<Footer />
</Layout>
