---
// /terms, copy from content/copy/terms.md. Business name, website, location,
// email and effective date come from src/site.config.ts.
import { site, siteLocation } from "../site.config";
import LegalPage from "../components/LegalPage.astro";

const email = site.email;
---

<LegalPage
	title="Terms of Use"
	description={`The terms for using ${site.website}, the website of ${site.businessName}, based in ${siteLocation}.`}
>
	<h2>About these terms</h2>
	<p>
		These terms cover your use of {site.website}, run by {site.businessName}, based in {siteLocation}. By using the
		website, you agree to them. Any project we deliver is covered by a separate written agreement, which takes
		priority.
	</p>

	<h2>Using the website</h2>
	<p>
		Use this website to learn about our services and book a call. Do not misuse it, for example by attacking its
		security, copying it in bulk or using it unlawfully.
	</p>

	<h2>Our content</h2>
	<p>
		The text, design, logos and other material here belong to {site.businessName} unless stated otherwise. You may
		link to our pages, but not copy or reuse our material for your business without written permission.
	</p>

	<h2>Information on this website</h2>
	<p>
		It is general information about our services, not advice for your business. We keep it accurate and current as
		best we can. Case study results are real results for those clients. Yours will depend on your business and how
		the system is used.
	</p>

	<h2>Third-party services</h2>
	<p>
		Some features use other companies' services, such as Calendly for booking. Their own terms and privacy policies
		apply.
	</p>

	<h2>Limitation of liability</h2>
	<p>
		The website is provided as it is. To the extent the law allows, {site.businessName} is not liable for any loss
		from using, or being unable to use, it.
	</p>

	<h2>Governing law</h2>
	<p>These terms are governed by the laws of the State of {site.state}, {site.country}.</p>

	<h2>Changes</h2>
	<p>We may update these terms. The latest version is always on this page with its effective date.</p>

	<h2>Contact</h2>
	<p><a href={`mailto:${email}`}>{email}</a></p>
</LegalPage>
