---
// One page per case study, built from content/copy/case-studies/<slug>.md.
// Leads with the headline number, then the problem, what we built and the
// result, a link back to the solution, the tools as a small strip at the
// bottom, then the booking CTA. Any of these whose line is removed from
// the copy file (headline number, result, testimonial, tools) is skipped
// cleanly instead of leaving a gap.
import type { GetStaticPaths } from "astro";
import { site } from "../../site.config";
import { type CaseStudy, getCaseStudies, getRelatedSolution } from "../../lib/content";
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import Label from "../../components/Label.astro";
import Card from "../../components/Card.astro";
import Icon from "../../components/Icon.astro";
import BigNumber from "../../components/BigNumber.astro";
import CopyBlocks from "../../components/CopyBlocks.astro";
import PageCTA from "../../components/PageCTA.astro";
import { isPlaceholder } from "../../lib/copy-format";

export const getStaticPaths = (async () => {
	const caseStudies = await getCaseStudies();
	return caseStudies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
	entry: CaseStudy;
}

const { entry } = Astro.props;
const { title, clientLabel, headlineNumber, numberCaption, summary, problem, built, result, testimonial, tools } =
	entry.data;
const solution = await getRelatedSolution(entry);

const story = [
	{ heading: "The problem", blocks: problem },
	{ heading: "What we built", blocks: built },
].filter((step) => step.blocks.length > 0);
---

<Layout title={`${clientLabel}, ${site.businessName} case study`} description={summary}>
	<Nav />
	<main>
		<PageHeader title={title} lead={summary} back={{ href: "/case-studies", label: "All case studies" }}>
			<div slot="before-title" class="space-y-4 pb-[var(--space-head)]">
				<Label text={clientLabel} brackets={false} class="block" />
				{headlineNumber && <BigNumber value={headlineNumber} size="hero" />}
				{
					headlineNumber && numberCaption && (
						<p
							class:list={[
								isPlaceholder(numberCaption)
									? "inline-block rounded-card border border-dashed border-ink-3 px-3 py-2 font-mono text-label uppercase text-ink-3"
									: "max-w-[36ch] text-body text-ink-2",
							]}
						>
							{numberCaption}
						</p>
					)
				}
			</div>
		</PageHeader>

		<Section>
			<Container>
				<div class="max-w-[720px] space-y-[var(--space-block)]">
					{
						story.map((step) => (
							<section class="space-y-5 border-t border-rule pt-8">
								<h2 class="font-display text-h3 text-core">{step.heading}</h2>
								<CopyBlocks blocks={step.blocks} />
							</section>
						))
					}

					{
						result.length > 0 && (
							<section class="space-y-5 border-t border-rule pt-8">
								<h2 class="font-display text-h3 text-core">The result</h2>
								<Card variant="panel">
									<CopyBlocks blocks={result} class="[&_p]:font-display [&_p]:text-h3 [&_p]:text-core" />
								</Card>
							</section>
						)
					}

					{
						testimonial.length > 0 && (
							<figure class="border-t border-rule pt-8">
								<blockquote class="space-y-4 font-display text-h3 text-core">
									{testimonial.map((block) => block.type === "p" && <p>{block.text}</p>)}
								</blockquote>
							</figure>
						)
					}

					{
						solution && (
							<section class="space-y-5 border-t border-rule pt-8">
								<h2 class="font-display text-h3 text-core">Solution</h2>
								<a
									href={`/solutions/${solution.id}`}
									class="group block rounded-card outline-none transition-transform duration-150 ease-out hover:-translate-y-px focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-vector"
								>
									<Card class="flex items-start gap-5">
										<Icon name={solution.data.icon} class="mt-1 h-7 w-7 shrink-0 text-core" />
										<div class="min-w-0 flex-1 space-y-2">
											<p class="font-display text-h3 text-core">{solution.data.title}</p>
											<p class="text-body text-ink-2">{solution.data.cardLine}</p>
										</div>
										<Icon name="arrow-right" class="mt-2 hidden h-5 w-5 shrink-0 text-core sm:block" />
									</Card>
								</a>
							</section>
						)
					}

					{
						tools.length > 0 && (
							<section class="flex flex-col gap-3 border-t border-rule pt-8 sm:flex-row sm:items-baseline sm:gap-6">
								<h2 class="shrink-0 font-mono text-label uppercase text-ink-3">Tools</h2>
								<ul class="flex flex-wrap gap-2">
									{tools.map((tool) => (
										<li
											class:list={[
												"rounded-full border px-3 py-1 text-small",
												isPlaceholder(tool)
													? "border-dashed border-ink-3 font-mono uppercase text-ink-3"
													: "border-rule bg-null text-ink-2",
											]}
										>
											{tool}
										</li>
									))}
								</ul>
							</section>
						)
					}
				</div>
			</Container>
		</Section>

		<PageCTA />
	</main>
	<Footer />
</Layout>
