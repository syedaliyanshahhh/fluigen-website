---
// /case-studies: every case study. Heading is the homepage's case studies
// heading (content/copy/home.md section 6).
//
// Rhythm: hero on the flow field, every case study as a glass card in one
// dark scene (featured first, two per row from sm up), then the closing band.
import { getCaseStudies } from "../../lib/content";
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Scene from "../../components/Scene.astro";
import PageHero from "../../components/PageHero.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import PageCTA from "../../components/PageCTA.astro";

const caseStudies = await getCaseStudies();
// Featured case studies lead, in their homepage order, then the rest.
const ordered = [
	...caseStudies.filter((entry) => entry.data.featured),
	...caseStudies.filter((entry) => !entry.data.featured),
];
---

<Layout
	title="Case studies"
	description="Work that is already running: the AI receptionists, follow-up, portals and hiring systems we have built for real businesses, and what changed for each one."
>
	<Nav />
	<main id="main">
		<PageHero title="Work that is already running" />

		<Scene>
			<h2 class="sr-only">Case studies</h2>
			<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:gap-8">
				{
					ordered.map((caseStudy) => (
						<li class="min-w-0">
							<CaseStudyCard caseStudy={caseStudy} variant="glass" class="h-full" />
						</li>
					))
				}
			</ul>
		</Scene>

		<PageCTA />
	</main>
	<Footer />
</Layout>
