---
// /case-studies: every case study, homepage-featured ones first. Heading is
// the homepage's case studies heading (content/copy/home.md section 6).
import { site } from "../../site.config";
import { getCaseStudies } from "../../lib/content";
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import PageCTA from "../../components/PageCTA.astro";

const caseStudies = await getCaseStudies();
---

<Layout
	title="Case studies"
	description="Work that is already running: the AI receptionists, follow-up, portals and hiring systems we have built for real businesses, and what changed for each one."
>
	<Nav />
	<main id="main">
		<PageHeader title="Work that is already running" />
		<Section glow="left">
			<Container>
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
					{caseStudies.map((caseStudy) => <CaseStudyCard caseStudy={caseStudy} />)}
				</div>
			</Container>
		</Section>
		<PageCTA />
	</main>
	<Footer />
</Layout>
