---
// /how-we-work, copy from content/copy/how-we-work.md.
import { site } from "../site.config";
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import PageHeader from "../components/PageHeader.astro";
import Label from "../components/Label.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import PageCTA from "../components/PageCTA.astro";

const steps = [
	{
		title: "Audit (free)",
		paragraphs: [
			"A 30-minute call with Aliyan. We look at where your team loses the most hours and pick the processes worth automating first.",
			"Within 48 hours you get a one-page plan: three processes to automate, the hours each one saves per week, and a fixed price for each build.",
			"The plan is yours to keep, even if you never hire us.",
		],
	},
	{
		title: "Build",
		paragraphs: [
			"Week one: we confirm the scope, get access to the tools involved and map the process step by step with you.",
			"Week two: we build it in your own accounts and test it with real examples.",
			"You give us about two hours of your time across the whole build.",
		],
	},
	{
		title: "Go live",
		paragraphs: [
			"We run the new system alongside your current way of working until it handles real work without mistakes.",
			"Then we hand it over with written documentation and a short video walkthrough, and you pay the second half.",
			"Most builds are live in 2 to 3 weeks from kickoff.",
		],
	},
	{
		title: "Care Plan (optional)",
		paragraphs: ["A monthly plan that keeps everything running:"],
		items: [
			"We monitor it and fix issues before they reach you",
			"We update it when one of your tools changes",
			"We make small improvements as your business changes",
			"You get a short report each month on what it handled",
		],
	},
];

const needFromYou = [
	"Access to the tools the process runs on",
	"One point of contact on your side",
	"About two hours of your time across the build",
];

const ownership = [
	"We build inside your own accounts wherever possible, so your data stays in the tools you already use",
	"We only ask for the access a build needs, and you can remove it the day we hand over",
	"At handover you get every login, the workflows themselves, written documentation and a video walkthrough",
];

const guarantees = [
	{
		title: "Pay the second half when it is live",
		description: "50% to start, the rest only once the system is running in your business. Not before.",
	},
	{
		title: "You own everything",
		description: "Your accounts, your data, your workflows, full documentation and a handover video.",
	},
	{
		title: "30 days of free fixes",
		description: "If something needs adjusting after launch, we fix it at no cost.",
	},
];
---

<Layout
	title={`How we work, ${site.businessName}`}
	description="How a Fluigen build works: a free audit, a fixed-price build, a live launch and an optional care plan. You pay the second half only once it runs."
>
	<Nav />
	<main>
		<PageHeader
			title="Four steps, one fixed price, and you pay the second half only when it works."
			lead="Every project follows the same path, so you always know what happens next, what we need from you and what it costs."
		/>

		<!-- The four steps -->
		<Section>
			<Container>
				<ol class="grid grid-cols-1 gap-x-8 gap-y-[var(--space-block)] lg:grid-cols-2 lg:gap-x-16">
					{
						steps.map((step, index) => (
							<li class="max-w-[720px] space-y-5 border-t border-rule pt-8">
								<Label text={`Step ${index + 1}`} />
								<h2 class="font-display text-h2 text-core">{step.title}</h2>
								<div class="space-y-4 text-body text-ink-2">
									{step.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
									{step.items && (
										<ul class="space-y-4 pt-1">
											{step.items.map((item) => (
												<li class="flex gap-3">
													<Icon name="check" class="mt-[3px] h-5 w-5 shrink-0 text-core" />
													<span>{item}</span>
												</li>
											))}
										</ul>
									)}
								</div>
							</li>
						))
					}
				</ol>
			</Container>
		</Section>

		<!-- What we need from you / Ownership and security -->
		<Section class="border-t border-rule">
			<Container>
				<div class="grid grid-cols-1 gap-[var(--space-block)] lg:grid-cols-2 lg:gap-16">
					{
						[
							{ heading: "What we need from you", items: needFromYou },
							{ heading: "Ownership and security", items: ownership },
						].map((group) => (
							<div class="max-w-[720px]">
								<h2 class="font-display text-h2 text-core">{group.heading}</h2>
								<ul class="mt-[var(--space-head)] space-y-4">
									{group.items.map((item) => (
										<li class="flex gap-3 text-body text-ink-2">
											<Icon name="check" class="mt-[3px] h-5 w-5 shrink-0 text-core" />
											<span>{item}</span>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<!-- Our guarantees -->
				<h2 class="mt-[var(--space-block)] border-t border-rule pt-[var(--space-block)] font-display text-h2 text-core">
					Our guarantees
				</h2>
				<div class="mt-[var(--space-head)] grid grid-cols-1 gap-6 sm:grid-cols-3 lg:gap-8">
					{
						guarantees.map((guarantee) => (
							<Card class="space-y-4">
								<Icon name="check" class="h-6 w-6 text-core" />
								<h3 class="font-display text-h3 text-core">{guarantee.title}</h3>
								<p class="text-body text-ink-2">{guarantee.description}</p>
							</Card>
						))
					}
				</div>
			</Container>
		</Section>

		<PageCTA heading="Step one is free." text={false} />
	</main>
	<Footer />
</Layout>
