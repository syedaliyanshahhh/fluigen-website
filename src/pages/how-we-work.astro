---
// /how-we-work, copy from content/copy/how-we-work.md.
//
// Rhythm: hero on the flow field, the four steps as light columns with a
// drawn progress line, the guarantees as a dark scene with glass cards,
// what we need and ownership as two light checklists, then the closing
// band ("Step one is free.").
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Scene from "../components/Scene.astro";
import PageHero from "../components/PageHero.astro";
import Label from "../components/Label.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import PageCTA from "../components/PageCTA.astro";

const steps = [
	{
		title: "Audit (free)",
		items: [
			"A 30-minute call with Aliyan",
			"Within 48 hours, a plan: three processes, hours saved and a fixed price for each",
			"Yours to keep, even if you never hire us",
		],
	},
	{
		title: "Build",
		items: [
			"Week one: scope, access and a map of the process",
			"Week two: built in your accounts, tested with real examples",
			"About two hours of your time",
		],
	},
	{
		title: "Go live",
		items: [
			"Runs alongside your current process until it handles real work without mistakes",
			"Handover with docs and a video, then you pay the second half",
			"Most builds live in 2 to 3 weeks",
		],
	},
	{
		title: "Care Plan (optional)",
		items: [
			"Monitored, with issues fixed before they reach you",
			"Updated when your tools change",
			"Small improvements and a short monthly report",
		],
	},
];

const guarantees = [
	{ title: "Pay the second half when it is live", description: "50% to start, the rest once it runs." },
	{ title: "You own everything", description: "Accounts, data, docs and a handover video." },
	{ title: "30 days of free fixes", description: "After launch, at no cost." },
];

const lists = [
	{
		heading: "What we need from you",
		items: ["Access to the tools involved", "One point of contact", "About two hours of your time"],
	},
	{
		heading: "Ownership and security",
		items: [
			"Built in your own accounts, so your data stays in your tools",
			"Only the access a build needs, removable at handover",
			"Every login, workflow and doc handed over",
		],
	},
];
---

<Layout
	title="How we work"
	description="How a Fluigen build works: a free audit, a fixed-price build, a live launch and an optional care plan. You pay the second half only once it runs."
>
	<Nav />
	<main id="main">
		<PageHero title="Four steps, one fixed price." lead="You pay the second half only when it works." />

		<!-- The four steps -->
		<Section>
			<Container>
				<ol class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
					{
						steps.map((step, index) => (
							<li class="step-line space-y-4 border-t border-rule pt-6">
								<Label text={`Step ${index + 1}`} />
								<h2 class="font-display text-h3 text-core">{step.title}</h2>
								<ul class="space-y-3">
									{step.items.map((item) => (
										<li class="flex gap-3 text-body text-ink-2">
											<Icon name="check" class="mt-[0.3em] h-5 w-5 shrink-0 text-core" />
											<span>{item}</span>
										</li>
									))}
								</ul>
							</li>
						))
					}
				</ol>
			</Container>
		</Section>

		<!-- Our guarantees (dark scene) -->
		<Scene>
			<h2 class="font-display text-h2 text-core max-w-[16ch]">Our guarantees</h2>
			<ul class="mt-[var(--space-head)] grid grid-cols-1 gap-4 sm:grid-cols-3 lg:gap-8">
				{
					guarantees.map((guarantee) => (
						<li>
							<Card variant="glass" class="h-full space-y-4 lg:p-8">
								<span class="grid h-11 w-11 place-items-center rounded-full bg-core text-baseline">
									<Icon name="check" class="h-5 w-5" />
								</span>
								<h3 class="font-display text-h3 text-core">{guarantee.title}</h3>
								<p class="text-body text-ink-2">{guarantee.description}</p>
							</Card>
						</li>
					))
				}
			</ul>
		</Scene>

		<!-- What we need from you / Ownership and security -->
		<Section glow="right">
			<Container class="grid grid-cols-1 gap-[var(--space-block)] lg:grid-cols-2 lg:gap-16">
				{
					lists.map((group) => (
						<div>
							<h2 class="font-display text-h2 text-core max-w-[14ch]">{group.heading}</h2>
							<ul class="mt-[var(--space-head)] border-t border-rule">
								{group.items.map((item) => (
									<li class="flex gap-3 border-b border-rule py-4 text-body text-core">
										<Icon name="check" class="mt-[0.3em] h-5 w-5 shrink-0 text-core" />
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</Container>
		</Section>

		<PageCTA heading="Step one is free." text={false} />
	</main>
	<Footer />
</Layout>
