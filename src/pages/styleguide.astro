---
// Dev-only token and component reference (docs/build-plan.md Phase 2).
// Not linked from Nav/Footer. Noindexed by Layout.astro.
import Layout from "../components/Layout.astro";
import Button from "../components/Button.astro";
import Label from "../components/Label.astro";
import Card from "../components/Card.astro";

import horizon from "../../design/gradients/horizon-hero-2400x1400.jpg";
import arch from "../../design/gradients/arch-1000x1250.jpg";
import edge from "../../design/gradients/edge-1800x1200.jpg";
import mist from "../../design/gradients/mist-cta-2400x1200.jpg";

const colors = [
	{ token: "baseline", hex: "#F7F7F7", role: "Page background" },
	{ token: "null", hex: "#FFFFFF", role: "Cards and surfaces" },
	{ token: "core", hex: "#000000", role: "Body text, headlines, primary button" },
	{ token: "ink-2", hex: "#3A3A3A", role: "Secondary text" },
	{ token: "ink-3", hex: "#6B6B6B", role: "Muted text, captions" },
	{ token: "rule", hex: "#DCDCDC", role: "Borders and dividers" },
	{ token: "flux", hex: "#97C1C5", role: "Gradients only, image-only, never a flat color or utility class" },
	{ token: "vector", hex: "#267B85", role: "Gradients, focus ring, hover details, 2px lines" },
	{ token: "substation", hex: "#02525E", role: "Gradients, fallback background behind gradient images" },
];

const typeStyles = [
	{
		name: "Hero H1",
		className: "font-display text-hero-h1",
		sample: "Your business, running on its own.",
		meta: "Inter Tight 300 · desktop 104/100 · mobile 44/46 · tracking -4.5%",
	},
	{
		name: "H1 (inner pages)",
		className: "font-display text-h1",
		sample: "Built to run without you.",
		meta: "Inter Tight 400 · desktop 72/72 · mobile 40/42 · tracking -3%",
	},
	{
		name: "H2",
		className: "font-display text-h2",
		sample: "We map the process before we build.",
		meta: "Inter Tight 400 · desktop 56/58 · mobile 34/36 · tracking -3%",
	},
	{
		name: "H3",
		className: "font-display text-h3",
		sample: "Platforms connected by one workflow.",
		meta: "Inter Tight 400 · desktop 28/34 · mobile 22/28 · tracking -1.5%",
	},
	{
		name: "Body",
		className: "font-sans text-body",
		sample: "We cut your onboarding from three days to twenty minutes.",
		meta: "Inter 400 · desktop 18/29 · mobile 17/27 · tracking 0",
	},
	{
		name: "Small",
		className: "font-sans text-small",
		sample: "Real numbers, clean layouts, nothing extra.",
		meta: "Inter 400 · 15/22 at every width · tracking 0",
	},
	{
		name: "Label",
		className: "font-mono text-label uppercase",
		sample: "[ operations automated ]",
		meta: "Cascadia Code 400 · desktop 13/18 · mobile 12/16 · tracking +4%, uppercase",
	},
	{
		name: "Big number",
		className: "font-display text-big-number",
		sample: "99.9%",
		meta: "Inter Tight 300 · desktop 72/72 · mobile 48/48 · tracking -5%",
	},
];
---

<Layout
	title="Styleguide"
	noindex
	description="Dev-only token and component reference. Not part of the public site."
>
	<main id="main" class="container-content section-y space-y-20">
		<header class="space-y-3">
			<Label text="dev only, noindexed" />
			<h1 class="font-display text-h1">Styleguide</h1>
			<p class="text-body text-ink-2 max-w-[60ch]">
				Every color, type style, button, card and gradient token used on
				this site, pulled from design/brand.md. Nothing here is linked
				from the public nav or footer.
			</p>
		</header>

		<!-- Colors -->
		<section class="space-y-6">
			<h2 class="font-display text-h2">Colors</h2>
			<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{
					colors.map((c) => (
						<li class="rounded-card border border-rule overflow-hidden">
							<div
								class="h-20 w-full border-b border-rule"
								style={`background-color: ${c.hex};`}
							/>
							<div class="p-4 space-y-1">
								<p class="font-mono text-label uppercase text-core">{c.token}</p>
								<p class="text-small text-ink-3">{c.hex}</p>
								<p class="text-small text-ink-2">{c.role}</p>
							</div>
						</li>
					))
				}
			</ul>
		</section>

		<!-- Typography -->
		<section class="space-y-10">
			<h2 class="font-display text-h2">Typography</h2>
			<p class="text-body text-ink-2 max-w-[60ch]">
				Every sample below uses the live responsive utility. Resize the
				window, or check at 390px and 1440px, to see the mobile and
				desktop values each one carries.
			</p>
			<ul class="space-y-10">
				{
					typeStyles.map((t) => (
						<li class="border-t border-rule pt-6 space-y-2">
							<p class="font-mono text-label uppercase text-ink-3">{t.name}</p>
							<p class={`${t.className} text-core`}>{t.sample}</p>
							<p class="text-small text-ink-3">{t.meta}</p>
						</li>
					))
				}
			</ul>
		</section>

		<!-- Buttons -->
		<section class="space-y-8">
			<h2 class="font-display text-h2">Buttons</h2>
			<p class="text-body text-ink-2 max-w-[60ch]">
				Hover lifts every variant 1px. Tab to any button to see the 2px
				vector focus ring, offset 3px.
			</p>

			<div class="space-y-3">
				<p class="font-mono text-label uppercase text-ink-3">Primary</p>
				<Button href="/book">Book your free automation audit</Button>
			</div>

			<div class="space-y-3 bg-core rounded-panel p-8">
				<p class="font-mono text-label uppercase text-null/70">Primary, inverse (on a gradient)</p>
				<Button href="/book" inverse>Book your free automation audit</Button>
			</div>

			<div class="space-y-3">
				<p class="font-mono text-label uppercase text-ink-3">Secondary</p>
				<Button href="/book" variant="secondary">See our work</Button>
			</div>

			<div class="space-y-3">
				<p class="font-mono text-label uppercase text-ink-3">Text link</p>
				<Button href="/book" variant="text">Book your free automation audit</Button>
			</div>
		</section>

		<!-- Cards -->
		<section class="space-y-6">
			<h2 class="font-display text-h2">Cards</h2>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<Card variant="card">
					<p class="font-mono text-label uppercase text-ink-3">Card, 20px radius</p>
					<p class="text-body text-core mt-2">
						White surface, 1px rule border, no drop shadow.
					</p>
				</Card>
				<Card variant="panel">
					<p class="font-mono text-label uppercase text-ink-3">Large panel, 28px radius</p>
					<p class="text-body text-core mt-2">
						Same surface and border, larger radius for bigger panels.
					</p>
				</Card>
			</div>
		</section>

		<!-- Label -->
		<section class="space-y-4">
			<h2 class="font-display text-h2">Label</h2>
			<Label text="guarantee" />
		</section>

		<!-- Gradients -->
		<section class="space-y-8">
			<h2 class="font-display text-h2">Gradients</h2>
			<p class="text-body text-ink-2 max-w-[60ch]">
				Always the image files below, never a CSS gradient. White text
				only on the dark part, black text only on the light part.
			</p>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<figure class="relative rounded-card overflow-hidden border border-rule">
					<img
						src={horizon.src}
						alt="Horizon gradient: deep teal at the top dissolving into baseline at the bottom"
						class="w-full h-auto aspect-[2400/1400] object-cover"
					/>
					<span class="absolute top-6 left-6 font-display text-h3 text-null">Horizon</span>
					<span class="absolute bottom-6 left-6 font-display text-h3 text-core">Hero, final CTA</span>
					<figcaption class="sr-only">Horizon gradient sample</figcaption>
				</figure>

				<figure class="relative rounded-card overflow-hidden border border-rule">
					<img
						src={arch.src}
						alt="Arch gradient: a soft column of teal rising from the bottom, fading to baseline at the edges"
						class="w-full h-auto aspect-[1000/1250] object-cover"
					/>
					<span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-display text-h3 text-null">Arch</span>
					<span class="absolute top-6 left-6 font-display text-h3 text-core">Founder photo, empty states</span>
					<figcaption class="sr-only">Arch gradient sample</figcaption>
				</figure>

				<figure class="relative rounded-card overflow-hidden border border-rule">
					<img
						src={edge.src}
						alt="Edge gradient: teal bleeding in from the top right corner, mostly baseline elsewhere"
						class="w-full h-auto aspect-[1800/1200] object-cover"
					/>
					<span class="absolute top-6 right-6 font-display text-h3 text-null">Edge</span>
					<span class="absolute bottom-6 left-6 font-display text-h3 text-core">Light sections, a hint of color</span>
					<figcaption class="sr-only">Edge gradient sample</figcaption>
				</figure>

				<figure class="relative rounded-card overflow-hidden border border-rule">
					<img
						src={mist.src}
						alt="Mist gradient: a drifting field from dark teal at the top left to baseline at the bottom right"
						class="w-full h-auto aspect-[2400/1200] object-cover"
					/>
					<span class="absolute top-6 left-6 font-display text-h3 text-null">Mist</span>
					<span class="absolute bottom-6 right-6 font-display text-h3 text-core">Final CTA band</span>
					<figcaption class="sr-only">Mist gradient sample</figcaption>
				</figure>
			</div>
		</section>
	</main>
</Layout>
