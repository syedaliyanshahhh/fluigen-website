---
// One page per solution, built from content/copy/solutions/<slug>.md.
// Reads top to bottom as a story: the problem, what we build, what changes,
// the timeline, then the case studies that prove it, then the booking CTA.
// A section whose copy is removed from the file is skipped, and the step
// numbers close up around it.
import type { GetStaticPaths } from "astro";
import { site } from "../../site.config";
import { type Solution, getRelatedCaseStudies, getSolutions } from "../../lib/content";
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import Label from "../../components/Label.astro";
import Card from "../../components/Card.astro";
import Icon from "../../components/Icon.astro";
import CopyBlocks from "../../components/CopyBlocks.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import PageCTA from "../../components/PageCTA.astro";

export const getStaticPaths = (async () => {
	const solutions = await getSolutions();
	return solutions.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
	entry: Solution;
}

const { entry } = Astro.props;
const { title, cardLine, seoDescription, icon, problem, build, changes, timeline } = entry.data;
const relatedCaseStudies = await getRelatedCaseStudies(entry);

const story = [
	{ heading: "The problem", blocks: problem },
	{ heading: "What we build", blocks: build },
	{ heading: "What changes", blocks: changes, highlight: true },
	{ heading: "Typical timeline", blocks: timeline },
].filter((step) => step.blocks.length > 0);
---

<Layout title={title} description={seoDescription ?? cardLine}>
	<Nav />
	<main id="main">
		<PageHeader title={title} lead={cardLine} back={{ href: "/solutions", label: "All solutions" }}>
			<Icon slot="before-title" name={icon} class="h-8 w-8 text-core" />
		</PageHeader>

		<Section glow="left">
			<Container>
				<ol class="max-w-[720px] space-y-[var(--space-block)]">
					{
						story.map((step, index) => (
							<li class="space-y-5 border-t border-rule pt-8">
								<Label text={String(index + 1).padStart(2, "0")} />
								<h2 class="font-display text-h3 text-core">{step.heading}</h2>
								{step.highlight ? (
									<Card variant="panel">
										<CopyBlocks blocks={step.blocks} />
									</Card>
								) : (
									<CopyBlocks blocks={step.blocks} />
								)}
							</li>
						))
					}
				</ol>
			</Container>
		</Section>

		{
			relatedCaseStudies.length > 0 && (
				<Section class="border-t border-rule">
					<Container>
						<h2 class="font-display text-h2 text-core">
							{relatedCaseStudies.length === 1 ? "Case study" : "Case studies"}
						</h2>
						<div class="mt-[var(--space-head)] grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
							{relatedCaseStudies.map((caseStudy) => (
								<CaseStudyCard caseStudy={caseStudy} />
							))}
						</div>
					</Container>
				</Section>
			)
		}

		<PageCTA />
	</main>
	<Footer />
</Layout>
