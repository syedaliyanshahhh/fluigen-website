---
// /about, copy from content/copy/about.md. Business name and city come
// from src/site.config.ts.
//
// Rhythm: hero on the flow field, the founder note (light; the only place
// "I" is used), what we believe as a dark scene with glass cards, where we
// work (light), then the closing band.
import { site } from "../site.config";
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Scene from "../components/Scene.astro";
import PageHero from "../components/PageHero.astro";
import Label from "../components/Label.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import FounderPhoto from "../components/FounderPhoto.astro";
import PageCTA from "../components/PageCTA.astro";

const story = [
	"I started in performance marketing. The ads worked. What failed came after the click: missed calls and leads nobody followed up.",
	`So I moved into automation. ${site.businessName} builds those systems properly, hands them over and stands behind them.`,
];
const storyClose = "Book an audit and you talk to me, not a sales rep.";

// "The team" section: hidden at launch (content/MISSING.md). Put the team
// copy here to show it again.
const teamPlaceholder = "";

const beliefs = [
	{ title: "Outcomes over jargon", description: "If we cannot explain it plainly, we have not understood it." },
	{ title: "You own what we build", description: "No lock-in, full handover." },
	{ title: "Real numbers only", description: "We never show results we cannot stand behind." },
];
---

<Layout
	title="About"
	description={`${site.businessName} is an AI automation agency based in ${site.city}. We build systems that answer calls, follow up leads and run back-office work for growing businesses.`}
>
	<Nav />
	<main id="main">
		<PageHero
			title="We build the systems that keep a business running when nobody is free."
			lead="An AI automation agency for owner-led businesses. Calls answered, leads followed up, back-office work handled."
		/>

		<!-- Why Fluigen exists (founder note: the only place "I" is used) -->
		<Section>
			<Container class="grid grid-cols-1 items-center gap-10 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:grid-cols-12 lg:gap-10">
				<FounderPhoto class="w-full max-w-[min(360px,72vw)] lg:col-span-4" />
				<div class="max-w-[600px] space-y-6 lg:col-span-7 lg:col-start-6">
					<h2 class="font-display text-h2 text-core">Why {site.businessName} exists</h2>
					<div class="space-y-4 text-body text-ink-2">
						{story.map((paragraph) => <p>{paragraph}</p>)}
					</div>
					<p class="font-display text-h3 text-core">{storyClose}</p>
					<p class="text-small text-ink-3">Aliyan Shah, founder</p>
				</div>
			</Container>
		</Section>

		{
			teamPlaceholder && (
				<Section class="border-t border-rule">
					<Container>
						<h2 class="font-display text-h2 text-core">The team</h2>
						<p class="mt-[var(--space-head)] inline-block rounded-card border border-dashed border-ink-3 px-4 py-3 font-mono text-label uppercase text-ink-3">
							{teamPlaceholder}
						</p>
					</Container>
				</Section>
			)
		}

		<!-- What we believe (dark scene) -->
		<Scene>
			<h2 class="font-display text-h2 text-core">What we believe</h2>
			<ul class="mt-[var(--space-head)] grid grid-cols-1 gap-4 sm:grid-cols-3 lg:gap-8">
				{
					beliefs.map((belief, index) => (
						<li>
							<Card variant="glass" class="h-full space-y-4 lg:p-8">
								<Label text={String(index + 1).padStart(2, "0")} />
								<h3 class="font-display text-h3 text-core">{belief.title}</h3>
								<p class="text-body text-ink-2">{belief.description}</p>
							</Card>
						</li>
					))
				}
			</ul>
		</Scene>

		<!-- Where we work -->
		<Section glow="right">
			<Container class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-10">
				<h2 class="font-display text-h2 text-core lg:col-span-5">Where we work</h2>
				<p class="flex max-w-[46ch] gap-3 text-body text-ink-2 lg:col-span-7">
					<Icon name="map-pin" class="mt-[0.3em] h-5 w-5 shrink-0 text-core" />
					<span>Based in {site.city}. We work your business hours, in the US, UK, Europe or Australia.</span>
				</p>
			</Container>
		</Section>

		<PageCTA />
	</main>
	<Footer />
</Layout>
