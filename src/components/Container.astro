---
// Max-width (1280px) + responsive side padding (20/32/48/64px) primitive —
// design/brand.md "Layout". Wraps the `container-content` utility from
// global.css. Used by Nav, page content and Footer so they share one left
// and right edge.
interface Props {
	as?: string;
	class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container-content", className]}>
	<slot />
</Tag>
