---
// Max-width (1240px) + side padding (72/20px) primitive — design/brand.md
// "Layout". Wraps the `container-content` utility from global.css.
interface Props {
	as?: string;
	class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container-content", className]}>
	<slot />
</Tag>
