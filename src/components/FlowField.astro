---
// The living teal gradient (design/brand.md "Flow gradient"). Decorative
// only: absolutely positioned behind its section's content, hidden from
// assistive tech. Styles and variants are in src/styles/flow.css.
//
// - hero:    strongest field, behind the floating nav, bleeds into the next section
// - closing: the final call to action band, dissolves in and out
// - soft:    light haze behind an inner page header
// - glow-left / glow-right: one faint drifting light behind an ordinary section
// - scene:   teal light rising out of black, inside a Scene
// - arch:    the same column of light, inside a framed panel (EmptyState)
//
// Parents must be positioned (`relative`), and need no background of their
// own except scenes and panels, so the field shows through.
export type FlowVariant = "hero" | "closing" | "soft" | "glow-left" | "glow-right" | "scene" | "arch";

interface Props {
	variant: FlowVariant;
	class?: string;
}

const { variant, class: className } = Astro.props;

const blobs = {
	hero: 4,
	closing: 3,
	soft: 2,
	"glow-left": 1,
	"glow-right": 1,
	scene: 3,
	arch: 2,
}[variant];

const isGlow = variant.startsWith("glow");
const grain = !isGlow && variant !== "soft";
---

<div
	class:list={["flow", `flow--${variant}`, isGlow && "flow--glow", className]}
	aria-hidden="true"
	data-flow
>
	<div class="flow__drift">
		{Array.from({ length: blobs }, () => <span class="flow__blob" />)}
	</div>
	{grain && <div class="flow__grain" />}
</div>

<script>
	// Run a field's drift only while it is on screen.
	const fields = document.querySelectorAll<HTMLElement>("[data-flow]");
	if ("IntersectionObserver" in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) entry.target.classList.toggle("is-live", entry.isIntersecting);
			},
			{ rootMargin: "120px 0px" },
		);
		fields.forEach((field) => observer.observe(field));
	} else {
		fields.forEach((field) => field.classList.add("is-live"));
	}
</script>
