---
// Calm, readable shell for /privacy and /terms: the soft page header (a
// light haze, no strong field), then just the 720px text column. Ends with
// a plain booking button rather than the gradient CTA band.
import { site } from "../site.config";
import Layout from "./Layout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import Container from "./Container.astro";
import Section from "./Section.astro";
import PageHeader from "./PageHeader.astro";
import InlineCTA from "./InlineCTA.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
	<Nav />
	<main id="main">
		<PageHeader title={title}>
			<p class="text-small text-ink-3">Effective date: {site.legalEffectiveDate}</p>
		</PageHeader>
		<Section reveal={false} class="!pt-[var(--space-head)]">
			<Container>
				<article class="max-w-[720px]">
					<div
						class="space-y-5 text-body text-ink-2 prose-links [&_a]:outline-none [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-[3px] [&_a:focus-visible]:outline-solid [&_a:focus-visible]:outline-ring [&_h2]:pt-6 [&_h2]:font-display [&_h2]:text-h3 [&_h2]:text-core [&_li]:pl-1 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
					>
						<slot />
					</div>
					<InlineCTA class="mt-[var(--space-block)] border-t border-rule pt-8" />
				</article>
			</Container>
		</Section>
	</main>
	<Footer />
</Layout>
