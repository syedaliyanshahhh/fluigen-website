---
// Repeated "button + short note" pattern (e.g. homepage sections 1, 3, 5, 7, 10).
import { site } from "../site.config";
import Button from "./Button.astro";

interface Props {
	label?: string;
	note?: string;
	class?: string;
}

const { label = "Book your free automation audit", note, class: className } = Astro.props;
---

<div class:list={["flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-5", className]}>
	<Button href={site.bookingPath}>{label}</Button>
	{note && <p class="text-small text-ink-3">{note}</p>}
</div>
