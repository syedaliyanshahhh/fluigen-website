---
// Sticky header: logo left, primary links, "Book a free audit" button
// (CLAUDE.md: sticky on every page, desktop and mobile, exact wording),
// plus a hamburger-opened full-screen menu below the lg breakpoint
// (design/brand.md "Layout" nav spec, 1024px / 390px check).
import logo from "../../design/logos/fluigen-horizontal-black.svg";
import { site } from "../site.config";
import Icon from "./Icon.astro";
import Container from "./Container.astro";
import Button from "./Button.astro";

const navLinks = [
	{ href: "/solutions", label: "Solutions" },
	{ href: "/case-studies", label: "Case studies" },
	{ href: "/how-we-work", label: "How we work" },
	{ href: "/about", label: "About" },
];

const linkClass =
	"text-body text-core underline-offset-[5px] decoration-1 hover:underline focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-vector";

const bookButtonSmallClass =
	"inline-flex h-11 shrink-0 items-center justify-center rounded-full bg-core px-3.5 font-display font-medium text-[15px] leading-none text-null outline-none transition-transform duration-150 ease-out hover:-translate-y-px focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-vector sm:px-[18px]";

const mobileLinkClass =
	"block border-b border-rule py-5 font-display text-h3 text-core outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-vector";
---

<header
	id="site-header"
	class="sticky top-0 z-50 h-[var(--nav-h)] border-b border-transparent bg-baseline transition-colors duration-200"
>
	<Container class="flex h-full items-center justify-between gap-3 sm:gap-4">
		<a href="/" aria-label={`${site.businessName} home`} class="shrink-0 rounded-sm outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-vector">
			<img src={logo.src} width={logo.width} height={logo.height} alt={site.businessName} class="h-[var(--nav-logo-h)] w-auto" />
		</a>

		<nav aria-label="Primary" class="hidden lg:block">
			<ul class="flex items-center gap-8">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} class={linkClass}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-2 sm:gap-3">
			<a href={site.bookingPath} class={bookButtonSmallClass}>Book a free audit</a>

			<button
				id="nav-toggle"
				type="button"
				class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-rule outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-vector lg:hidden"
				aria-expanded="false"
				aria-controls="nav-mobile-menu"
				aria-label="Open menu"
			>
				<Icon name="menu" id="nav-icon-menu" class="h-6 w-6 text-core" />
				<Icon name="x" id="nav-icon-close" class="hidden h-6 w-6 text-core" />
			</button>
		</div>
	</Container>
</header>

<div
	id="nav-mobile-menu"
	class="hidden fixed inset-x-0 top-[var(--nav-h)] bottom-0 z-40 flex-col overflow-y-auto bg-baseline lg:hidden"
>
	<nav aria-label="Mobile">
		<Container class="flex flex-col py-2">
			{
				navLinks.map((link) => (
					<a href={link.href} class={mobileLinkClass}>
						{link.label}
					</a>
				))
			}
		</Container>
	</nav>
	<Container class="mt-auto py-8">
		<Button href={site.bookingPath} class="w-full justify-center">Book your free automation audit</Button>
	</Container>
</div>

<script>
	const header = document.getElementById("site-header");
	const toggle = document.getElementById("nav-toggle");
	const menu = document.getElementById("nav-mobile-menu");
	const iconMenu = document.getElementById("nav-icon-menu");
	const iconClose = document.getElementById("nav-icon-close");

	function setOpen(open) {
		menu?.classList.toggle("hidden", !open);
		menu?.classList.toggle("flex", open);
		iconMenu?.classList.toggle("hidden", open);
		iconClose?.classList.toggle("hidden", !open);
		toggle?.setAttribute("aria-expanded", String(open));
		toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		document.documentElement.classList.toggle("overflow-hidden", open);
	}

	toggle?.addEventListener("click", () => {
		setOpen(Boolean(menu?.classList.contains("hidden")));
	});

	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setOpen(false));
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && !menu?.classList.contains("hidden")) {
			setOpen(false);
			toggle?.focus();
		}
	});

	const desktopQuery = window.matchMedia("(min-width: 1024px)");
	desktopQuery.addEventListener("change", (event) => {
		if (event.matches) setOpen(false);
	});

	function updateScrolled() {
		const scrolled = window.scrollY > 0;
		header?.classList.toggle("border-rule", scrolled);
		header?.classList.toggle("border-transparent", !scrolled);
	}
	updateScrolled();
	window.addEventListener("scroll", updateScrolled, { passive: true });
</script>
