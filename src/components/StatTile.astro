---
// Big-number + Label pair, for the proof strip and similar stat rows. The
// number counts up when it scrolls into view (src/scripts/motion.ts).
interface Props {
	value: string;
	label: string;
	class?: string;
}

const { value, label, class: className } = Astro.props;
---

<div class:list={["min-w-0 space-y-2", className]}>
	<p class="font-display text-big-number text-core break-words" data-count>{value}</p>
	<p class="font-mono text-label uppercase text-ink-3">{label}</p>
</div>
