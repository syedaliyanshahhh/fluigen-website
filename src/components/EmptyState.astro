---
// Arch-gradient placeholder frame — design/brand.md designates `arch` for
// "founder photo frame or empty states". Used wherever an asset hasn't
// landed yet (founder photo, audio recording, and so on).
import { Image } from "astro:assets";
import arch from "../../design/gradients/arch-1000x1250.jpg";

interface Props {
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={["relative overflow-hidden rounded-panel bg-substation", className]}>
	<Image
		src={arch}
		alt=""
		aria-hidden="true"
		format="webp"
		widths={[480, 1000]}
		sizes="(min-width: 1024px) 50vw, 100vw"
		loading="lazy"
		class="absolute inset-0 h-full w-full object-cover"
	/>
	<div class="relative z-10 flex h-full items-center justify-center">
		<slot />
	</div>
	<p class="absolute inset-x-0 bottom-0 p-6 font-mono text-label uppercase text-null">
		{label}
	</p>
</div>
