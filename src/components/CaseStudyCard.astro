---
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import BigNumber from "./BigNumber.astro";

interface Props {
	caseStudy: CollectionEntry<"case-studies">;
	/** Glass over a scene or flow field (homepage); solid elsewhere. */
	variant?: "card" | "glass";
	/** A shorter summary for this placement (content/copy/home.md). */
	summary?: string;
	class?: string;
}

const { caseStudy, variant = "card", summary: summaryOverride, class: className } = Astro.props;
const { clientLabel, headlineNumber } = caseStudy.data;
const summary = summaryOverride ?? caseStudy.data.summary;
const href = `/case-studies/${caseStudy.id}`;
---

<a
	href={href}
	class:list={[
		"group block min-w-0 rounded-card outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-ring",
		className,
	]}
>
	<Card variant={variant} interactive class="h-full min-w-0 space-y-4">
		{headlineNumber && <BigNumber value={headlineNumber} />}
		<p class="font-mono text-label uppercase text-ink-3">{clientLabel}</p>
		<p class="text-body text-ink-2">{summary}</p>
	</Card>
</a>
