---
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import BigNumber from "./BigNumber.astro";

interface Props {
	caseStudy: CollectionEntry<"case-studies">;
	class?: string;
}

const { caseStudy, class: className } = Astro.props;
const { clientLabel, headlineNumber, summary } = caseStudy.data;
const href = `/case-studies/${caseStudy.id}`;
---

<a
	href={href}
	class:list={[
		"group block min-w-0 rounded-card outline-none transition-transform duration-150 ease-out hover:-translate-y-px focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-vector",
		className,
	]}
>
	<Card class="h-full min-w-0 space-y-4">
		{headlineNumber && <BigNumber value={headlineNumber} />}
		<p class="font-mono text-label uppercase text-ink-3">{clientLabel}</p>
		<p class="text-body text-ink-2">{summary}</p>
	</Card>
</a>
