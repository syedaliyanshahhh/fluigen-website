---
// Closing booking band for every marketing page: the mist gradient (the
// page's one gradient moment on inner pages), one button to the booking
// page. Default heading and text are the homepage's final CTA copy
// (content/copy/home.md section 12); pages with their own CTA copy pass it in.
import { site } from "../site.config";
import Container from "./Container.astro";
import GradientSection from "./GradientSection.astro";
import Button from "./Button.astro";

interface Props {
	heading?: string;
	text?: string | false;
}

const {
	heading = "Find the first thing worth automating",
	text = "30 minutes, and you leave with a written plan, even if you never hire us.",
} = Astro.props;
---

<GradientSection variant="mist" class="section-y">
	<Container>
		<div class="max-w-[520px] space-y-6">
			<h2 class="font-display text-h2 text-null">{heading}</h2>
			{text && <p class="text-body text-null max-w-[46ch]">{text}</p>}
			<Button href={site.bookingPath} inverse>Book your free automation audit</Button>
		</div>
	</Container>
</GradientSection>
