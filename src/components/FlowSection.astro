---
// A section on a flow field: the homepage hero and the closing call to
// action band (design/brand.md "Flow gradient").
//
// - hero: content follows the page theme (black on the pale light-mode
//   field, white on the near-black dark-mode field).
// - closing: content is a dark theme context, so the ordinary `text-core`
//   / Button classes come out white-on-teal in both page themes. Keep it in
//   the upper left, darker part: the field dissolves to baseline at the
//   bottom right, where white text would fail contrast.
import FlowField from "./FlowField.astro";

interface Props {
	variant: "hero" | "closing";
	id?: string;
	class?: string;
}

const { variant, id, class: className } = Astro.props;
---

<section id={id} class:list={["relative", className]} data-flow-section={variant}>
	<FlowField variant={variant} />
	<div data-theme={variant === "closing" ? "dark" : undefined} class="relative">
		<slot />
	</div>
</section>
