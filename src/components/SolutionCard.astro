---
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import Icon from "./Icon.astro";

interface Props {
	solution: CollectionEntry<"solutions">;
	class?: string;
}

const { solution, class: className } = Astro.props;
const { title, cardDescription, icon } = solution.data;
const href = `/solutions/${solution.id}`;
---

<a
	href={href}
	class:list={[
		"group block rounded-card outline-none transition-transform duration-150 ease-out hover:-translate-y-px focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-vector",
		className,
	]}
>
	<Card class="h-full space-y-5">
		<Icon name={icon} class="h-7 w-7 text-core" />
		<h3 class="font-display text-h3 text-core">{title}</h3>
		<p class="text-body text-ink-2">{cardDescription}</p>
		<span class="inline-block text-small text-core underline underline-offset-[5px] decoration-1">
			How it works
		</span>
	</Card>
</a>
